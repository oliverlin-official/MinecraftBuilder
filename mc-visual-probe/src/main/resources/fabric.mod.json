{
	"schemaVersion": 1,
	"id": "mc-visual-probe",
	"version": "${version}",
	"name": "Minecraft Visual Probe",
	"description": "Localhost visual sensor: move the Minecraft camera to a pose and capture a real framebuffer PNG.",
	"authors": [
		"Minecraft Environment Factory"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"mcenv.visualprobe.VisualProbeClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
